@model RuleListViewModel
@{
    ViewBag.Title = Model.Action;
}
@section scripts{
    @Scripts.Render("~/js/jqueryui")
    @Scripts.Render("~/js/rule")
}
<header>
    <h3>@Model.Action</h3>
</header>
<div class="panel">
    <table class="table table-striped">
        @Html.Partial("_Header", Model.Header)
        @if(Model.ApiViewModel != null)
        {
            @Html.Partial("_Body", Model)
        }
    </table>
    <div>
        <button type="button" id="add" data-toggle="modal" data-target="#myModal" data-url="@Url.Action(Model.Action, "Rule", new { method = "Add", help = Model.Help })" class="btn btn-primary">Add</button>
        <button type="button" id="save" data-url="@Url.Action(Model.Action, "Rule", new { method = "Sort", help = Model.Help })" class="btn btn-primary">Update Sort</button>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModalLabel">@Model.Action</h4>
            </div>
            <div class="modal-body form-add">
            </div>
            <div class="modal-footer"></div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->